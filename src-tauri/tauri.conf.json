{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Vault",
  "mainBinaryName": "nexus-vault",
  "version": "1.0.0",
  "identifier": "com.nexusvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus Vault",
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#15171B"
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nexus Vault",
    "category": "Utility",
    "shortDescription": "Local-first password manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Russian": "nsis/Russian.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NzJFNkVBRDhCQTlGQjAKUldTd243clk2dVp5dVN1Vk9oamJRZXdyMG83cnFDWDhZaGFVckpwTXZoVU5uWW13blRHazRERkoK",
      "endpoints": [
        "https://github.com/STANFORDVIBE/nexus-vault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
